plugins {
    id 'java'
    id 'xyz.wagyourtail.unimined' version '1.4.1'
}

group = rootProject.findProperty('chronos.mod.group')
version = rootProject.findProperty('chronos.mod.version')

base {
    archivesName = '{{archivesName}}'
}

java {
    toolchain {
        languageVersion = JavaLanguageVersion.of(8)
    }
}

unimined.useGlobalCache = true

repositories {
    mavenCentral()
    maven { url = 'https://maven.wagyourtail.xyz/releases' }
    maven { url = 'https://maven.minecraftforge.net/' }
}

unimined.minecraft {
    version '{{minecraft}}'

    mappings {
        searge()
        mcp '{{mcpChannel}}', '{{mcpVersion}}'
    }

    minecraftForge {
        loader '{{forgeVersion}}'
    }

    defaultRemapJar = true
}

configurations {
    chronosEmbedded {
        canBeResolved = true
        canBeConsumed = false
    }
}

dependencies {
    def nightConfigVer = rootProject.findProperty('chronos.nightconfig.version') ?: '3.6.7'
    implementation "com.electronwill.night-config:core:${nightConfigVer}"
    implementation "com.electronwill.night-config:toml:${nightConfigVer}"
    chronosEmbedded "com.electronwill.night-config:core:${nightConfigVer}"
    chronosEmbedded "com.electronwill.night-config:toml:${nightConfigVer}"
    runtimeOnly "net.minecrell:terminalconsoleappender:1.2.0"
}

tasks.named('jar', Jar) {
    from {
        configurations.chronosEmbedded.collect { zipTree(it) }
    }
    duplicatesStrategy = DuplicatesStrategy.EXCLUDE
}

sourceSets.main.java.srcDirs(
    rootProject.file('core/src/main/java'),
    rootProject.file('shell-shared/src/main/java'),
    rootProject.file('shell-forge/forge-shared-command-registrar/src/main/java'),
    rootProject.file('shell-forge/forge-common-1_8-1_12/src/main/java'),
    rootProject.file('shell-forge/forge-common-1_11-1_12/src/main/java'),
    rootProject.file('shell-forge/forge-common-1_10-1_12/src/main/java'),
    rootProject.file('shell-forge/v1_11/src/main/java'),
)

processResources {
    dependsOn rootProject.tasks.named('prepareBuildIcon')
    inputs.property 'version', project.version
    inputs.property 'mod_id', rootProject.findProperty('chronos.mod.id')
    inputs.property 'mod_name', rootProject.findProperty('chronos.mod.name')
    inputs.property 'mod_description', rootProject.findProperty('chronos.mod.description')
    inputs.property 'mod_author', rootProject.findProperty('chronos.mod.author')
    from(rootProject.layout.buildDirectory.file('generated/icon-128.png')) {
        into ''
        rename { 'icon.png' }
    }
    filesMatching('mcmod.info') {
        expand(
                'version': project.version,
                'mod_id': rootProject.findProperty('chronos.mod.id'),
                'mod_name': rootProject.findProperty('chronos.mod.name'),
                'mod_description': rootProject.findProperty('chronos.mod.description'),
                'mod_author': rootProject.findProperty('chronos.mod.author')
        )
    }
}

tasks.withType(JavaCompile).configureEach {
    options.encoding = 'UTF-8'
}

/** Dev: vanilla dedicated server exits until eula.txt exists, create once, never overwrite. */
def chronosPrepareForgeRunServer = tasks.register('chronosPrepareForgeRunServer') {
    doLast {
        def serverRunDir = file('run/server')
        serverRunDir.mkdirs()
        def eulaFile = new File(serverRunDir, 'eula.txt')
        if (!eulaFile.exists()) {
            eulaFile.text = '''# By changing the setting below to TRUE you are indicating your agreement to our EULA (https://aka.ms/MinecraftEULA).
# Generated automatically for Chronos dev runServer on first launch.
eula=true
'''
            logger.lifecycle('Chronos: wrote {} for local dev (first run only)', eulaFile)
        }
    }
}

tasks.named('runServer') {
    dependsOn chronosPrepareForgeRunServer
    args '--nogui'
}
