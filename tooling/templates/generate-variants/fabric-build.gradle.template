plugins {
    id '{{pluginId}}' version '{{loomVersion}}'
}

import java.net.ServerSocket
import java.util.Properties

group = rootProject.findProperty('chronos.mod.group')
version = rootProject.findProperty('chronos.mod.version')

base { archivesName = "{{archivesName}}" }

repositories {
    mavenCentral()
}

loom {
    runs {
        server {
            programArgs '--nogui'
        }
    }
}

dependencies {
    def nightConfigVer = rootProject.findProperty('chronos.nightconfig.version') ?: '3.6.7'
    minecraft "com.mojang:minecraft:{{minecraft}}"
    {{mappings}}
    {{depConf}} "net.fabricmc:fabric-loader:{{fabricLoader}}"
    {{depConf}} "net.fabricmc.fabric-api:fabric-api:{{fabricApi}}"
    // Night Config (NeoForge bundles this; Fabric needs both jars — core has ConfigFormat; toml is the TOML backend).
    include implementation("com.electronwill.night-config:core:${nightConfigVer}")
    include implementation("com.electronwill.night-config:toml:${nightConfigVer}")
}

sourceSets.main.java.srcDirs(
    rootProject.file('core/src/main/java'),
    rootProject.file('shell-shared/src/main/java'),
    rootProject.file('shell-brigadier/src/main/java'),
    rootProject.file('shell-mojmap/common/src/main/java'),
    {{mojmapNumericGateGroovy}}
    {{mojmapMojmapSliceGroovy}}
    rootProject.file('shell-fabric/src/main/java'),
)

processResources {
    inputs.property 'version', project.version
    inputs.property 'minecraft', '{{minecraft}}'
    inputs.property 'mod_id', rootProject.findProperty('chronos.mod.id')
    inputs.property 'mod_name', rootProject.findProperty('chronos.mod.name')
    inputs.property 'mod_description', rootProject.findProperty('chronos.mod.description')
    inputs.property 'mod_author', rootProject.findProperty('chronos.mod.author')
    inputs.property 'mod_license', rootProject.findProperty('chronos.mod.license')
    filesMatching('fabric.mod.json') {
        expand 'version': project.version,
               'minecraft': '{{minecraft}}',
               'minecraft_dep': '{{minecraftDep}}',
               'java_dep': '{{javaDep}}',
               'mod_id': rootProject.findProperty('chronos.mod.id'),
               'mod_name': rootProject.findProperty('chronos.mod.name'),
               'mod_description': rootProject.findProperty('chronos.mod.description'),
               'mod_author': rootProject.findProperty('chronos.mod.author'),
               'mod_license': rootProject.findProperty('chronos.mod.license')
    }
}

java {
    withSourcesJar()
    toolchain { languageVersion = JavaLanguageVersion.of({{javaMajor}}) }
}

tasks.withType(JavaCompile).configureEach {
    options.encoding = 'UTF-8'
    options.release = {{javaMajor}}
}

def chronosSelectFreePort = {
    def socket = new ServerSocket(0)
    try {
        return socket.localPort
    } finally {
        socket.close()
    }
}

def chronosPrepareRunServerPort = tasks.register('chronosPrepareRunServerPort') {
    doLast {
        def runDir = new File(projectDir, 'run')
        runDir.mkdirs()

        def serverProperties = new File(runDir, 'server.properties')
        def properties = new Properties()
        if (serverProperties.exists()) {
            serverProperties.withInputStream { properties.load(it) }
        }

        def selectedPort = chronosSelectFreePort()
        properties.setProperty('server-port', selectedPort.toString())
        serverProperties.withOutputStream { properties.store(it, 'Updated by Gradle runServer task') }

        logger.lifecycle("Chronos selected random server port ${selectedPort} for runServer")
    }
}

tasks.named('runServer') {
    dependsOn chronosPrepareRunServerPort
}{{remapJarBlock}}
