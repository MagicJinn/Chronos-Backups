plugins {
    id '{{pluginId}}' version '{{loomVersion}}'
}

import java.net.ServerSocket
import java.util.Properties

group = rootProject.findProperty('chronos.mod.group')
version = rootProject.findProperty('chronos.mod.version')

base { archivesName = "{{archivesName}}" }

repositories {
    mavenCentral()
}

loom {
    runs {
        server {
            programArgs '--nogui'
        }
    }
}

dependencies {
    def nightConfigVer = rootProject.findProperty('chronos.nightconfig.version') ?: '3.6.7'
    minecraft "com.mojang:minecraft:{{minecraft}}"
    {{mappings}}
    {{depConf}} "net.fabricmc:fabric-loader:{{fabricLoader}}"
    {{depConf}} "net.fabricmc.fabric-api:fabric-api:{{fabricApi}}"
    // Night Config (NeoForge bundles this, Fabric needs both jars - core has ConfigFormat, toml is the TOML backend).
    include implementation("com.electronwill.night-config:core:${nightConfigVer}")
    include implementation("com.electronwill.night-config:toml:${nightConfigVer}")
    def googleApiClientVer = rootProject.findProperty('chronos.google.api.client.version') ?: '2.7.2'
    def googleOauthClientVer = rootProject.findProperty('chronos.google.oauth.client.version') ?: '1.36.0'
    def googleDriveApiVer = rootProject.findProperty('chronos.google.api.services.drive.version') ?: 'v3-rev20230822-2.0.0'
    def googleHttpClientVer = rootProject.findProperty('chronos.google.http.client.version') ?: '1.45.2'
    def googleAuthLibraryVer = rootProject.findProperty('chronos.google.auth.library.version') ?: '1.30.0'
    def opencensusVer = rootProject.findProperty('chronos.opencensus.version') ?: '0.31.1'
    def grpcContextVer = rootProject.findProperty('chronos.grpc.context.version') ?: '1.68.2'
    // Loom `include` nests only the named artifact, not transitives. Nest the Drive stack explicitly.
    include implementation("com.google.api-client:google-api-client:${googleApiClientVer}")
    include implementation("com.google.oauth-client:google-oauth-client-jetty:${googleOauthClientVer}")
    include implementation("com.google.oauth-client:google-oauth-client-java6:${googleOauthClientVer}")
    include implementation("com.google.oauth-client:google-oauth-client:${googleOauthClientVer}")
    include implementation("com.google.apis:google-api-services-drive:${googleDriveApiVer}")
    include implementation("com.google.http-client:google-http-client:${googleHttpClientVer}")
    include implementation("com.google.http-client:google-http-client-gson:${googleHttpClientVer}")
    include implementation("com.google.http-client:google-http-client-apache-v2:${googleHttpClientVer}")
    include implementation("com.google.auth:google-auth-library-oauth2-http:${googleAuthLibraryVer}")
    include implementation("com.google.auth:google-auth-library-credentials:${googleAuthLibraryVer}")
    include implementation("io.opencensus:opencensus-api:${opencensusVer}")
    include implementation("io.opencensus:opencensus-contrib-http-util:${opencensusVer}")
    include implementation("io.grpc:grpc-context:${grpcContextVer}")
}

sourceSets.main.resources.srcDirs(
    rootProject.file('core/src/main/resources'),
)
sourceSets.main.java.srcDirs(
    rootProject.file('core/src/main/java'),
    rootProject.file('shell-shared/src/main/java'),
    rootProject.file('shell-brigadier/src/main/java'),
    rootProject.file('shell-mojmap/common/src/main/java'),
    {{mojmapNumericGateGroovy}}
    {{mojmapMojmapSliceGroovy}}
    {{fabricRegistrarSliceGroovy}}
    rootProject.file('shell-fabric/src/main/java'),
)

{{fabricShellMessengerCompatGroovy}}

{{fabricMojmapLegacyWorldGroovy}}

processResources {
    inputs.property 'version', project.version
    inputs.property 'minecraft', '{{minecraft}}'
    inputs.property 'mod_id', rootProject.findProperty('chronos.mod.id')
    inputs.property 'mod_name', rootProject.findProperty('chronos.mod.name')
    inputs.property 'mod_description', rootProject.findProperty('chronos.mod.description')
    inputs.property 'mod_author', rootProject.findProperty('chronos.mod.author')
    inputs.property 'mod_license', rootProject.findProperty('chronos.mod.license')
    filesMatching('fabric.mod.json') {
        expand 'version': project.version,
               'minecraft': '{{minecraft}}',
               'minecraft_dep': '{{minecraftDep}}',
               'java_dep': '{{javaDep}}',
               'mod_id': rootProject.findProperty('chronos.mod.id'),
               'mod_name': rootProject.findProperty('chronos.mod.name'),
               'mod_description': rootProject.findProperty('chronos.mod.description'),
               'mod_author': rootProject.findProperty('chronos.mod.author'),
               'mod_license': rootProject.findProperty('chronos.mod.license')
    }
}

java {
    withSourcesJar()
    toolchain { languageVersion = JavaLanguageVersion.of({{toolchainMajor}}) }
    sourceCompatibility = JavaVersion.toVersion({{javaDependencyResolutionMajor}})
    targetCompatibility = JavaVersion.toVersion({{javaDependencyResolutionMajor}})
}

tasks.withType(JavaCompile).configureEach {
    options.encoding = 'UTF-8'
    // JDK 8's javac does not seem to support --release. Loom may fork compilation with a Java 8 compiler for old MC lines.
{{fabricJavaCompileOptionsGroovy}}
}
{{fabricCompileClasspathJvmAttrsGroovy}}

def chronosSelectFreePort = {
    def socket = new ServerSocket(0)
    try {
        return socket.localPort
    } finally {
        socket.close()
    }
}

def chronosPrepareRunServerPort = tasks.register('chronosPrepareRunServerPort') {
    doLast {
        def runDir = new File(projectDir, 'run')
        runDir.mkdirs()

        def eulaFile = new File(runDir, 'eula.txt')
        if (!eulaFile.exists() || !eulaFile.text.contains('eula=true')) {
            eulaFile.text = 'eula=true'
            logger.lifecycle('Chronos: wrote {} for local Fabric runServer', eulaFile)
        }

        def serverProperties = new File(runDir, 'server.properties')
        def properties = new Properties()
        if (serverProperties.exists()) {
            serverProperties.withInputStream { properties.load(it) }
        }

        def selectedPort = chronosSelectFreePort()
        properties.setProperty('server-port', selectedPort.toString())
        serverProperties.withOutputStream { properties.store(it, 'Updated by Gradle runServer task') }

        logger.lifecycle("Chronos selected random server port ${selectedPort} for runServer")
    }
}

tasks.named('runServer') {
    dependsOn chronosPrepareRunServerPort
}{{remapJarBlock}}
