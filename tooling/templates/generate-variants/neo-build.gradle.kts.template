plugins {
    `java-library`
    id("net.neoforged.moddev") version "{{moddevVersion}}"
}

group = rootProject.findProperty("chronos.mod.group") as String
version = rootProject.findProperty("chronos.mod.version") as String

base { archivesName.set("{{archivesName}}") }

neoForge {
    version = "{{neoVersion}}"
    mods {
        register("chronosbackups") { sourceSet(sourceSets["main"]) }
    }
    runs {
        register("server") {
            server()
            programArgument("--nogui")
        }
    }
}

repositories {
    mavenCentral()
}

// Night Config is already on the compile/runtime classpath via NeoForge/FML - do not jar-in-jar or duplicate it here.

dependencies {
    val googleApiClientVer = rootProject.findProperty("chronos.google.api.client.version") ?: "2.7.2"
    val googleOauthClientVer = rootProject.findProperty("chronos.google.oauth.client.version") ?: "1.36.0"
    val googleDriveApiVer = rootProject.findProperty("chronos.google.api.services.drive.version") ?: "v3-rev20230822-2.0.0"
    val googleHttpClientVer = rootProject.findProperty("chronos.google.http.client.version") ?: "1.45.2"
    val googleAuthLibraryVer = rootProject.findProperty("chronos.google.auth.library.version") ?: "1.30.0"
    val opencensusVer = rootProject.findProperty("chronos.opencensus.version") ?: "0.31.1"
    val grpcApiVer = rootProject.findProperty("chronos.grpc.api.version") ?: "1.68.2"
    // Bundle Google Drive clients (NeoForge does not ship these). Exclude libs Minecraft already
    // provides with strictly pinned versions, otherwise compileClasspath cannot resolve.
    // jarJar does not nest transitives, so list the Drive stack explicitly.
    // grpc-context is empty since 1.57. Nest grpc-api (where io.grpc.Context lives).
    fun org.gradle.api.artifacts.ExternalModuleDependency.excludeMinecraftProvided() {
        exclude(group = "com.google.guava")
        exclude(group = "com.google.code.gson")
        exclude(group = "com.google.code.findbugs")
        exclude(group = "com.google.errorprone")
        exclude(group = "com.google.j2objc")
        exclude(group = "commons-codec")
        exclude(group = "org.apache.httpcomponents")
        exclude(group = "commons-logging")
    }
    val googleDriveCoords =
        listOf(
            "com.google.api-client:google-api-client:$googleApiClientVer",
            "com.google.oauth-client:google-oauth-client-jetty:$googleOauthClientVer",
            "com.google.oauth-client:google-oauth-client-java6:$googleOauthClientVer",
            "com.google.oauth-client:google-oauth-client:$googleOauthClientVer",
            "com.google.apis:google-api-services-drive:$googleDriveApiVer",
            "com.google.http-client:google-http-client:$googleHttpClientVer",
            "com.google.http-client:google-http-client-gson:$googleHttpClientVer",
            "com.google.http-client:google-http-client-apache-v2:$googleHttpClientVer",
            "com.google.auth:google-auth-library-oauth2-http:$googleAuthLibraryVer",
            "com.google.auth:google-auth-library-credentials:$googleAuthLibraryVer",
            "io.opencensus:opencensus-api:$opencensusVer",
            "io.opencensus:opencensus-contrib-http-util:$opencensusVer",
            "io.grpc:grpc-api:$grpcApiVer",
        )
    for (coord in googleDriveCoords) {
        jarJar(
            implementation(coord) {
                excludeMinecraftProvided()
            },
        )
    }
}

sourceSets.named("main") {
    // Shared NeoForge code plus optional line-specific trees under shell-neoforge/<line>/ (e.g. 1.20, 1.21, 26.1).
    // Prefer one unified jar per line, use line folders only when APIs diverge, not separate Gradle modules.
    java.srcDirs(
        rootProject.file("core/src/main/java"),
        rootProject.file("shell-shared/src/main/java"),
        rootProject.file("shell-brigadier/src/main/java"),
        rootProject.file("shell-mojmap/common/src/main/java"),
        {{mojmapNumericGateKts}}
        {{mojmapMojmapSliceKts}}
        rootProject.file("shell-neoforge/src/main/java"),
        rootProject.file("shell-neoforge/{{neoForgeLineDir}}/src/main/java"),
        {{neoShellExtraSrcKts}}
    )
    resources.srcDirs(
        rootProject.file("core/src/main/resources"),
    )
    {{neoShellExcludeKts}}
}

tasks.processResources {
    inputs.property("version", project.version)
    inputs.property("minecraft", "{{minecraft}}")
    inputs.property("mod_id", rootProject.findProperty("chronos.mod.id") as String)
    inputs.property("mod_name", rootProject.findProperty("chronos.mod.name") as String)
    inputs.property("mod_description", rootProject.findProperty("chronos.mod.description") as String)
    inputs.property("mod_author", rootProject.findProperty("chronos.mod.author") as String)
    inputs.property("mod_license", rootProject.findProperty("chronos.mod.license") as String)
    val neoMetadataExpand =
        mapOf(
            "version" to project.version,
            "minecraft_range" to "{{minecraftRange}}",
            "neo_version" to "{{neoVersion}}",
            "mod_id" to (rootProject.findProperty("chronos.mod.id") as String),
            "mod_name" to (rootProject.findProperty("chronos.mod.name") as String),
            "mod_description" to (rootProject.findProperty("chronos.mod.description") as String),
            "mod_author" to (rootProject.findProperty("chronos.mod.author") as String),
            "mod_license" to (rootProject.findProperty("chronos.mod.license") as String),
        )
    // mods.toml: NeoForge 20.2-20.4 / FML 1.x-2.x on those releases. neoforge.mods.toml: 20.5+.
    listOf("META-INF/mods.toml", "META-INF/neoforge.mods.toml").forEach { path ->
        filesMatching(path) { expand(neoMetadataExpand) }
    }
}

java {
    withSourcesJar()
    toolchain { languageVersion.set(JavaLanguageVersion.of({{javaToolchainMajor}})) }
    // Keep Gradle dependency resolution on the NeoForge JVM (21+). `--release` alone
    // would advertise Java 17 and break resolving neoform/FML artifacts.
    sourceCompatibility = org.gradle.api.JavaVersion.toVersion({{javaDependencyResolutionMajor}})
    targetCompatibility = org.gradle.api.JavaVersion.toVersion({{javaDependencyResolutionMajor}})
}
tasks.withType<JavaCompile>().configureEach {
    options.encoding = "UTF-8"
    {{neoJavaCompileOptionsKts}}
}

// NeoForge 20.6+ artifacts require JVM 21 at resolution time. If we pass `--release 17` (or
// `options.release`) for bytecode compatibility with older game versions, Gradle would
// otherwise request Java-17 variants of neoform/FML and fail. Force the compile classpath
// consumer to JVM {{javaDependencyResolutionMajor}} while still emitting `--release` bytecode above.
configurations.named("compileClasspath").configure {
    attributes {
        attribute(
            org.gradle.api.attributes.java.TargetJvmVersion.TARGET_JVM_VERSION_ATTRIBUTE,
            {{javaDependencyResolutionMajor}},
        )
    }
}
