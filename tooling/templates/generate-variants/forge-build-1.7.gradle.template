plugins {
    id 'java'
    id 'xyz.wagyourtail.unimined' version '1.4.1'
}

group = rootProject.findProperty('chronos.mod.group')
version = rootProject.findProperty('chronos.mod.version')

base {
    archivesName = '{{archivesName}}'
}

java {
    toolchain {
        languageVersion = JavaLanguageVersion.of(8)
    }
}

unimined.useGlobalCache = true

repositories {
    maven { url = 'https://maven.minecraftforge.net/' }
    exclusiveContent {
        forRepository {
            maven { url = 'https://maven.neoforged.net/releases' }
        }
        filter {
            includeGroupByRegex('net\\.neoforged(\\..*)?')
        }
    }
    mavenCentral()
    maven { url = 'https://maven.wagyourtail.xyz/releases' }
}

unimined.minecraft {
    version '{{minecraft}}'

    mappings {
        {{seargeInvocation}}
        mcp '{{mcpChannel}}', '{{mcpVersion}}'
    }

    minecraftForge {
        loader '{{forgeVersion}}'
    }

    defaultRemapJar = true
}

configurations {
    chronosEmbedded {
        canBeResolved = true
        canBeConsumed = false
        exclude group: 'com.google.guava'
        exclude group: 'com.google.code.gson'
        exclude group: 'com.google.code.findbugs'
        exclude group: 'com.google.errorprone'
        exclude group: 'com.google.j2objc'
        exclude group: 'commons-codec'
        exclude group: 'commons-logging'
        exclude group: 'org.apache.httpcomponents'
    }
}

dependencies {
    def nightConfigVer = rootProject.findProperty('chronos.nightconfig.version') ?: '3.6.7'
    // Forge 1.7.x-1.13.x does not ship Night Config on the launcher classpath. Embed it (pre-JPMS / LaunchWrapper - no duplicate-module issue).
    implementation "com.electronwill.night-config:core:${nightConfigVer}"
    implementation "com.electronwill.night-config:toml:${nightConfigVer}"
    chronosEmbedded "com.electronwill.night-config:core:${nightConfigVer}"
    chronosEmbedded "com.electronwill.night-config:toml:${nightConfigVer}"
    def googleApiClientVer = rootProject.findProperty('chronos.google.api.client.version') ?: '2.7.2'
    def googleOauthClientVer = rootProject.findProperty('chronos.google.oauth.client.version') ?: '1.36.0'
    def googleDriveApiVer = rootProject.findProperty('chronos.google.api.services.drive.version') ?: 'v3-rev20230822-2.0.0'
    implementation "com.google.api-client:google-api-client:${googleApiClientVer}"
    implementation "com.google.oauth-client:google-oauth-client-jetty:${googleOauthClientVer}"
    implementation "com.google.apis:google-api-services-drive:${googleDriveApiVer}"
    chronosEmbedded "com.google.api-client:google-api-client:${googleApiClientVer}"
    chronosEmbedded "com.google.oauth-client:google-oauth-client-jetty:${googleOauthClientVer}"
    chronosEmbedded "com.google.apis:google-api-services-drive:${googleDriveApiVer}"
}

tasks.withType(Jar).configureEach { t ->
    if (t.name == 'jar' || t.name == 'remapJar') {
        t.from {
            configurations.chronosEmbedded.collect { zipTree(it) }
        }
        // Old Forge ASM cannot parse Multi-Release / module-info entries from embedded deps.
        t.exclude 'META-INF/versions/**'
        t.exclude '**/module-info.class'
        // Forge ships Guava/Gson. Embedding them causes JPMS split packages on 1.17+.
        t.exclude 'com/google/common/**'
        t.exclude 'com/google/gson/**'
        t.exclude 'javax/annotation/**'
        t.exclude 'com/google/errorprone/**'
        t.exclude 'com/google/j2objc/**'
        t.exclude 'org/apache/commons/**'
        t.exclude 'org/apache/http/**'
        t.duplicatesStrategy = DuplicatesStrategy.EXCLUDE
    }
}

sourceSets.main.resources.srcDirs(
    rootProject.file('core/src/main/resources'),
)
sourceSets.main.java.srcDirs(
    rootProject.file('core/src/main/java'),
    rootProject.file('shell-shared/src/main/java'),
    rootProject.file('shell-forge/forge-shared-command-registrar/src/main/java'),
    rootProject.file('shell-forge/forge-common-1_7-1_8/src/main/java'),
)
{{forge17LineSourcesGroovy}}

processResources {
    dependsOn rootProject.tasks.named('prepareBuildIcon')
    inputs.property 'version', project.version
    inputs.property 'mod_id', rootProject.findProperty('chronos.mod.id')
    inputs.property 'mod_name', rootProject.findProperty('chronos.mod.name')
    inputs.property 'mod_description', rootProject.findProperty('chronos.mod.description')
    inputs.property 'mod_author', rootProject.findProperty('chronos.mod.author')
    from(rootProject.layout.buildDirectory.file('generated/icon-128.png')) {
        into ''
        rename { 'icon.png' }
    }
    filesMatching('mcmod.info') {
        expand(
                'version': project.version,
                'mod_id': rootProject.findProperty('chronos.mod.id'),
                'mod_name': rootProject.findProperty('chronos.mod.name'),
                'mod_description': rootProject.findProperty('chronos.mod.description'),
                'mod_author': rootProject.findProperty('chronos.mod.author')
        )
    }
}

tasks.withType(JavaCompile).configureEach {
    options.encoding = 'UTF-8'
}

/** Dev: vanilla dedicated server exits until eula.txt exists, create once, never overwrite. */
def chronosPrepareForgeRunServer = tasks.register('chronosPrepareForgeRunServer') {
    doLast {
        def serverRunDir = file('run/server')
        serverRunDir.mkdirs()
        def eulaFile = new File(serverRunDir, 'eula.txt')
        if (!eulaFile.exists()) {
            eulaFile.text = '''# By changing the setting below to TRUE you are indicating your agreement to our EULA (https://aka.ms/MinecraftEULA).
# Generated automatically for Chronos dev runServer on first launch.
eula=true
'''
            logger.lifecycle('Chronos: wrote {} for local dev (first run only)', eulaFile)
        }
    }
}

tasks.named('runServer', JavaExec).configure {
    dependsOn chronosPrepareForgeRunServer
    args '--nogui'
    doFirst {
        def guavaJars = classpath.files.findAll {
            it.name.toLowerCase().contains('guava') && it.name.toLowerCase().endsWith('.jar')
        }
        if (!guavaJars.isEmpty()) {
            def primaryGuava = guavaJars.find { it.name.startsWith('guava-17.') } ?: guavaJars.first()
            classpath = classpath.filter { file ->
                !(file.name.toLowerCase().contains('guava') && file.name.toLowerCase().endsWith('.jar'))
            }
            jvmArgs("-Xbootclasspath/a:${primaryGuava.absolutePath}")
            logger.lifecycle(
                    'Chronos: moved Guava to boot classpath for FG2 runServer classloader consistency (selected {}, removed {})',
                    primaryGuava.name,
                    guavaJars.collect { it.name }.join(', ')
            )
        }
    }
}
